# Custom partition table with two OTA app slots (see partitions.csv) —
# the default single-factory-partition scheme is too small for this
# firmware (WiFi + MQTT + mdns + mbedtls pulls in a fair amount of
# code) and OTA needs two slots anyway.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-C6-DevKitC-1 boards commonly ship with 4MB flash (some variants
# have 8MB) — 4MB is the safe minimum assumption; adjust if a specific
# board is confirmed to have more.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OTA_MANIFEST_URL/the .bin URL are plain http:// (trusted LAN, no TLS
# — matches esp32_watertank's convention). Without this,
# esp_https_ota() refuses to proceed at all ("No option for server
# verification is enabled"), failing every update with
# ESP_ERR_INVALID_ARG.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
